SANDBOX_WORKER_TOKEN=replace-with-a-long-random-worker-token
WORKER_HOST=127.0.0.1
WORKER_PORT=7001

# Preload each image locally. The worker never pulls images automatically.
# Build the reviewed images from the repository root:
# docker build -f worker/sandbox-images/git/Dockerfile -t termforge/git-exam:local worker/
# docker build -f worker/sandbox-images/docker/Dockerfile -t termforge/docker-exam:local worker/
# The Docker image uses an isolated command simulator; it never starts real
# containers or exposes the host Docker daemon to a candidate.
SANDBOX_IMAGE_GIT=
SANDBOX_IMAGE_DOCKER=termforge/docker-exam:local
SANDBOX_IMAGE_DATA_MIGRATION=
