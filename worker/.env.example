SANDBOX_WORKER_TOKEN=replace-with-a-long-random-worker-token
WORKER_HOST=127.0.0.1
WORKER_PORT=7001

# Preload each image locally. The worker never pulls images automatically.
# Images must contain /bin/sleep and /usr/local/bin/termforge-shell,
# and provide UID/GID 1000 for the workspace.
# The Git image also includes the Docker CLI; Docker operations are unavailable
# because sandbox workspaces do not connect to a Docker daemon.
SANDBOX_IMAGE_GIT=
SANDBOX_IMAGE_DOCKER=
SANDBOX_IMAGE_DATA_MIGRATION=
